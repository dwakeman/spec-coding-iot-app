# Workshop environment file. Copy to `.env` and fill in:
#
#   cp .env.example .env
#
# Then have your AI coding agent run `./setup/install-workshop.sh --yes`.

# Your IBM entitlement key for cp.icr.io. Get one from
#   https://myibm.ibm.com/products-services/containerlibrary
# It is a JWT-shaped string (~190 chars). Treat it like a password.
IBM_ENTITLEMENT_KEY=

# Backend service settings
PORT=3000
SERVICE_NAME=sensor-health-dashboard-backend
LOG_LEVEL=info

# Cassandra connectivity for SHD-003
# Use a comma-separated list if you have multiple contact points.
CASSANDRA_CONTACT_POINTS=127.0.0.1
CASSANDRA_PORT=9042
CASSANDRA_DATACENTER=datacenter1
CASSANDRA_KEYSPACE=iot
CASSANDRA_USERNAME=
CASSANDRA_PASSWORD=
CASSANDRA_CONNECT_TIMEOUT_MS=5000
CASSANDRA_REQUEST_TIMEOUT_MS=5000

# Presto / watsonx.data connectivity for SHD-011
# Set PRESTO_TLS_REJECT_UNAUTHORIZED=false only for local/self-signed development environments.
PRESTO_BASE_URL=https://your-presto-host:8443
PRESTO_CATALOG=iceberg_data
PRESTO_SCHEMA=iot
PRESTO_USER=
PRESTO_USERNAME=
PRESTO_PASSWORD=
PRESTO_TLS_REJECT_UNAUTHORIZED=true
PRESTO_REQUEST_TIMEOUT_MS=10000
